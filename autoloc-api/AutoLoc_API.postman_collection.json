{
  "info": {
    "name": "AutoLoc - Devoir REST API (SpringDoc OpenAPI)",
    "description": "Collection Postman pour tester et valider les endpoints CRUD de Vehicule, Client, Agence et l'accès Swagger UI pour le projet AutoLoc (ESPRIT - ASI).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Documentation Swagger & OpenAPI",
      "item": [
        {
          "name": "Accès Swagger UI HTML",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger-ui/index.html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swagger-ui",
                "index.html"
              ]
            },
            "description": "Vérifie l'accès à l'interface Swagger UI (redirection depuis /swagger-ui.html)"
          }
        },
        {
          "name": "Accès OpenAPI Spec JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            },
            "description": "Récupère le document JSON OpenAPI v3 généré par SpringDoc"
          }
        }
      ]
    },
